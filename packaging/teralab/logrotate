# TeraLab runtime logs. Rotation cannot reopen the file because the agent and
# the API keep their log files open, so copytruncate is used instead.
/var/lib/teralab/logs/*.log {
    su root root
    weekly
    rotate 8
    compress
    delaycompress
    missingok
    notifempty
    copytruncate
}
