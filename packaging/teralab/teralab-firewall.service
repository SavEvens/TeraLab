[Unit]
Description=TeraLab lab bridge forwarding rule
Documentation=https://github.com/SavEvens/TeraLab
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
# Root-owned helper, installed by apply-state.sh and the Debian package.
# /opt/teralab/packaging/teralab/teralab-firewall is the source copy only.
ExecStart=/usr/local/libexec/teralab/teralab-firewall
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
