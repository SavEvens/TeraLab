[Unit]
Description=TeraLab lab bridge forwarding rule
Documentation=https://github.com/SavEvens/TeraLab
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/opt/teralab/packaging/teralab/teralab-firewall
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
