{
  "name": "teralab/api",
  "description": "TeraLab control-plane API",
  "type": "project",
  "license": "AGPL-3.0-or-later",
  "require": {
    "php": ">=8.4",
    "monolog/monolog": "^3.9",
    "php-di/php-di": "^7.0",
    "slim/psr7": "^1.7",
    "slim/slim": "^4.14",
    "symfony/yaml": "^7.3"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "TeraLab\\Api\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "TeraLab\\Api\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "lint": "find src public tests -name '*.php' -print0 | xargs -0 -n1 php -l",
    "stan": "phpstan analyse --no-progress",
    "test": "phpunit"
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true,
    "platform": {
      "php": "8.4.0"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
