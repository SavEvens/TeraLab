      <node id="2" name="PC1" type="vpcs" template="vpcs" image="" ethernet="1" config="0" left="360" top="120">
        <interface id="0" name="eth0" type="ethernet" network_id="1"/>
      </node>
    </nodes>
    <networks>
      <network id="1" type="bridge" name="Net-1" left="220" top="120" visibility="0" icon="lan.png"/>
      <network id="2" type="pnet0" name="Cloud" left="480" top="120" visibility="1" icon="cloud.png"/>
    </networks>
  </topology>
  <objects>
