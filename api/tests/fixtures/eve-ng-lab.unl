  <description>EVE-NG fixture with base64 configs and encoded interfaces.</description>
  <body>Notes body.</body>
  <topology>
    <nodes>
      <node id="1" name="R1" type="iol" template="iol" image="x86_64_crb_linux-adventerprisek9-ms.bin" ethernet="1" nvram="1024" ram="1024" serial="0" icon="Router.png" keepalive="0" config="1" left="100" top="120">
